# Copy to .dev.vars (or .env — wrangler reads either) for local dev. For production: `wrangler secret put NAME`.

# --- Linq ---
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=whsec_...
# The line introductions open their group chat from. Only needed when the key has several numbers.
LINQ_FROM_NUMBER=

# --- iMessage app card identity ---
# Must match an installed Messages extension, or the card silently renders as
# plain text. Leave blank to send the card as a plain image + text instead.
IMESSAGE_TEAM_ID=
IMESSAGE_BUNDLE_ID=

# --- LLM: demo profile (spends OpenAI credits) ---
OPENAI_API_KEY=

# --- LLM: dev profile (any OpenAI-compatible endpoint; spends nothing of OpenAI's) ---
# Workers AI:  https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#              key = a Cloudflare API token, model = @cf/meta/llama-3.3-70b-instruct-fp8-fast
# Claude plan: http://127.0.0.1:11435/v1  key = unused  model = haiku   (run `npm run llm` first)
# Ollama:      http://localhost:11434/v1   key = ollama   model = qwen3:8b
DEV_LLM_BASE_URL=
DEV_LLM_API_KEY=
DEV_LLM_MODEL=

# --- Browserbase (research + booking browser sessions) ---
# Leave blank to fall back to Cloudflare Browser Rendering, which search engines
# and review sites tend to block. Project id is optional; it is inferred from the key.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Required for research: Jev gates search metadata and extracted specialist options.
# Use a Vercel AI Gateway key, not a TypeSafe key. Scores are not fact verification.
# Without this key, research stops before searching; there is no unscored fallback.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
RESEARCH_MIN_RELEVANCE=2
RESEARCH_MIN_CONFIDENCE=0.5

# --- Public URL of this Worker (card images, vote page, Shopify agent profile) ---
PUBLIC_BASE_URL=https://whim.<your-subdomain>.workers.dev

# --- Browserbase context holding the bot account's Instagram login (scripts/ig-login.mjs) ---
BROWSERBASE_CONTEXT_ID=

# Paying for carts. Leave off unless you mean to spend real money: anything but
# "true" prices the order in a browser and stops before a card is minted.
# PAYMENTS_LIVE=true
# The most one purchase may cost, in cents (default 6000).
# PAY_CAP_CENTS=6000
# Demo only: play a dry run out as a purchase. Ignored when PAYMENTS_LIVE=true.
# PAY_MOCK=true

# --- Sentry (optional; /runs diagnostics work without it) ---
# Create a Cloudflare/JavaScript project in Sentry; set the DSN as a Worker secret.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Fraction of traces exported (0..1). Errors and local dashboard spans are not sampled.
SENTRY_TRACES_SAMPLE_RATE=0.2
