{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whim",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "not_found_handling": "single-page-application",
    // Everything the Worker must answer itself; the rest is the React app.
    "run_worker_first": ["/api/*", "/agents/*", "/card/*", "/p/*", "/live/*", "/shot/*", "/.well-known/*"]
  },

  // One PlanAgent per iMessage group chat. Each is a Durable Object with its
  // own SQLite database, WebSockets and scheduler.
  // RunHub is a singleton: the only writer to the run-history D1 tables, and
  // the socket every open run viewer holds.
  "durable_objects": {
    "bindings": [
      { "name": "PlanAgent", "class_name": "PlanAgent" },
      { "name": "RunHub", "class_name": "RunHub" },
      // One instance ("global"): what each person has told us about themselves.
      { "name": "People", "class_name": "People" },
      { "name": "Website", "class_name": "Website" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PlanAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["RunHub"] },
    { "tag": "v3", "new_sqlite_classes": ["People"] },
    { "tag": "v4", "new_sqlite_classes": ["Website"] }
  ],

  // Run history: every agent turn, its events, tokens and timings.
  //   npx wrangler d1 execute htn-runs --local  --file migrations/0001_runs.sql
  //   npx wrangler d1 execute htn-runs --remote --file migrations/0001_runs.sql
  "d1_databases": [
    {
      "binding": "RUNS_DB",
      "database_name": "htn-runs",
      "database_id": "39a6971f-8c14-4c6d-ac41-165efcf6eb38"
    }
  ],

  "workflows": [
    {
      "name": "booking-workflow",
      "binding": "BOOKING_WORKFLOW",
      "class_name": "BookingWorkflow"
    },
    {
      "name": "research-workflow",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow"
    }
  ],

  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI" },
  // Vectorize has no local emulation: in `npm run dev` this talks to the real
  // index on the account (needs `wrangler login`), so dev and prod share a pool.
  "vectorize": [{ "binding": "PEOPLE_INDEX", "index_name": "htn-people", "remote": true }],
  // R2 caches rendered card PNGs. It is off because R2 must first be enabled on
  // the account (dashboard -> R2, needs a payment method). To turn it on:
  //   npx wrangler r2 bucket create htn-cards   then uncomment, `npm run types`, deploy.
  // Without it cards are simply rendered on every request.
  // "r2_buckets": [{ "binding": "CARDS", "bucket_name": "htn-cards" }],

  "vars": {
    // "demo" = OpenAI credits. "dev" = whatever DEV_LLM_* points at (Workers AI,
    // Ollama, ...) so testing doesn't spend them.
    "LLM_PROFILE": "dev",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "BOOKING_DRY_RUN": "true",
    // Demo: with payments off, a thumbs up ends as a (mock) purchase instead of
    // "dry run … nothing was charged". Remove, or turn PAYMENTS_LIVE on, to stop.
    "PAY_MOCK": "true",
    "IMESSAGE_APP_NAME": "Whim",
    // "true" records message text into run history,
    // so /runs can show the conversation. Decisions use structured summaries.
    // Run history is served over HTTP: turning this on means it holds what
    // real people wrote. Handles stay masked either way.
    "LOG_BODIES": "true"
  }
}
