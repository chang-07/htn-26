{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "./worker-configuration.d.ts",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "src",
    "worker-configuration.d.ts",
    "vite.config.ts"
  ]
}
